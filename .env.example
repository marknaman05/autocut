# Copy to .env and fill in. .env is gitignored; real environment variables
# override anything set here.

# --- Retake detection backend -------------------------------------------
# Default is a local model via Ollama and needs nothing here.
# To use a hosted model through OpenRouter instead, set both of these:
#
# AUTOCUT_RETAKE_BACKEND=openrouter
# OPENROUTER_API_KEY=sk-or-v1-...
#
# For working on the page without a model call per upload (nothing paid
# for, nothing waited on; the deterministic retake detector still runs):
#
# AUTOCUT_RETAKE_BACKEND=none
#
# Optional — the model to use. Default: google/gemini-3.8-flash
# Cheaper:  deepseek/deepseek-v4.1-flash
# Sharpest: anthropic/claude-sonnet-5
# AUTOCUT_RETAKE_MODEL=google/gemini-3.8-flash

# --- Transcription backend ------------------------------------------------
# Default is Whisper on Apple MLX, locally (needs `uv sync --extra asr` and
# Apple silicon).  To transcribe through OpenRouter's hosted Whisper instead
# -- same model family, ~1 cent per 15 minutes, no GPU and no Mac needed, so
# the server can run anywhere -- set this (OPENROUTER_API_KEY above is reused):
#
# AUTOCUT_ASR_BACKEND=openrouter
#
# Optional model override for either backend:
# AUTOCUT_ASR_MODEL=openai/whisper-large-v3

# --- Plans ----------------------------------------------------------------
# Everyone may upload, review, render and watch; only Pro downloads.  Until
# a payment gateway sets this, Pro is whoever is listed here (owners are Pro
# without being listed; so is the local user).  Comma-separated.
#
# AUTOCUT_PRO=friend@example.com,client@example.com
#
# A trial gets the whole product, downloads included, for a few videos;
# after that a new upload is what asks them to upgrade (re-rendering what
# they have stays free).  Credits are spent on upload and never refunded.
#
# AUTOCUT_TRIAL=someone@example.com
# AUTOCUT_TRIAL_CREDITS=3

# --- Payments (Dodo Payments) ---------------------------------------------
# With these set, "Upgrade to Pro" on /pricing opens a hosted checkout and a
# paid subscription makes the address Pro (the AUTOCUT_PRO list still works).
# Test mode is the default: use test-mode keys and a test-mode product, and
# pay with Dodo's test cards.  Switch DODO_PAYMENTS_ENVIRONMENT to live_mode
# with live keys when the product is real.
#
# DODO_PAYMENTS_API_KEY=...            Dashboard > Developer > API keys
# DODO_PRODUCT_ID=pdt_...              the Pro subscription product
# DODO_PAYMENTS_WEBHOOK_KEY=whsec_...  Dashboard > Developer > Webhooks > the endpoint's signing secret
# DODO_PAYMENTS_ENVIRONMENT=test_mode  or live_mode
# AUTOCUT_PUBLIC_URL=https://autocut.example.com   where checkout returns to
#
# The webhook endpoint is POST {AUTOCUT_PUBLIC_URL}/billing/webhook.  It has
# to be reachable without a login: behind Cloudflare Access, add a second
# Access application for the path autocut.example.com/billing/webhook with
# a Bypass / Everyone policy.  Deliveries are signature-checked either way.

# --- Instagram publishing ------------------------------------------------
# Lets the finished video be posted as a Reel from the web app or with
# `autocut publish`.  Set ONE of the two keys below; the README walks through
# getting either.  AUTOCUT_PUBLISH_BACKEND=upload-post|instagram forces the
# choice if both are set.

# (a) Through Upload-Post (app.upload-post.com) -- simplest, hosted relay.
# UPLOAD_POST_API_KEY=eyJ...
# Only needed when more than one Upload-Post profile has Instagram connected:
# UPLOAD_POST_USER=default

# (b) Directly through Meta -- needs a Meta developer app and an Instagram
# professional account; nothing goes through a third party.
# INSTAGRAM_ACCESS_TOKEN=IGAA...
#
# Optional.  Only needed with a Facebook-Login token, where one user can manage
# several Instagram accounts and the API cannot guess which one you mean.
# INSTAGRAM_USER_ID=17841400000000000
#
# Optional.  Defaults are graph.instagram.com and v25.0.  Set the host to
# https://graph.facebook.com if your token came from Facebook Login.
# INSTAGRAM_GRAPH_HOST=https://graph.instagram.com
# INSTAGRAM_API_VERSION=v25.0
